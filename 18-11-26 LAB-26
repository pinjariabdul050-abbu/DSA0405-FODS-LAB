import numpy as np
from sklearn.linear_model import LinearRegression

# Sample dataset: [Area_sqft, Bedrooms, Location_Score(1-10)]
X = np.array([
    [1200, 2, 6],
    [1500, 3, 7],
    [1800, 3, 8],
    [2200, 4, 8],
    [2500, 4, 9],
    [3000, 5, 9]
])
# Prices in USD
y = np.array([200000, 260000, 320000, 400000, 475000, 580000])

model = LinearRegression()
model.fit(X, y)

# User input
area = float(input("Enter house area (sq ft): "))
bedrooms = int(input("Enter number of bedrooms: "))
location = float(input("Enter location rating (1-10): "))

new_house = np.array([[area, bedrooms, location]])
predicted_price = model.predict(new_house)[0]

print(f"Predicted House Price: ${predicted_price:,.2f}")
