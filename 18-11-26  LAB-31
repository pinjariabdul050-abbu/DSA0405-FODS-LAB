import pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans

# Sample customer dataset
data = {
    'CustomerID': [101, 102, 103, 104, 105, 106, 107, 108],
    'Annual_Spend': [500, 620, 4800, 5100, 2100, 2400, 450, 4950],
    'Purchases_Per_Year': [4, 5, 38, 42, 16, 19, 3, 40],
    'Avg_Session_Mins': [5.2, 6.0, 22.5, 25.0, 12.0, 13.5, 4.8, 24.1]
}
df = pd.DataFrame(data)

features = ['Annual_Spend', 'Purchases_Per_Year', 'Avg_Session_Mins']
scaler = StandardScaler()
X_scaled = scaler.fit_transform(df[features])

kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)
df['Segment'] = kmeans.fit_predict(X_scaled)

print("Segmented Customers:")
print(df)
print("\nSegment Averages (Marketing Profile):")
print(df.groupby('Segment')[features].mean())
