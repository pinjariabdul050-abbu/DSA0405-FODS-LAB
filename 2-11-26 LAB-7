import pandas as pd

# Sample Dataset
data = {
    'customer_id': [101, 102, 101, 103, 102, 101],
    'order_date': pd.to_datetime(['2023-01-15', '2023-01-18', '2023-02-01', '2023-02-10', '2023-03-05', '2023-03-12']),
    'product_name': ['Laptop', 'Mouse', 'Mouse', 'Keyboard', 'Laptop', 'Keyboard'],
    'order_quantity': [1, 3, 2, 1, 2, 5]
}
order_data = pd.DataFrame(data)

# 1. Total number of orders made by each customer
orders_per_customer = order_data['customer_id'].value_counts()

# 2. Average order quantity for each product
avg_qty_per_product = order_data.groupby('product_name')['order_quantity'].mean()

# 3. Earliest and latest order dates
earliest_date = order_data['order_date'].min()
latest_date = order_data['order_date'].max()

print("--- Orders Per Customer ---")
print(orders_per_customer)
print("\n--- Average Order Quantity Per Product ---")
print(avg_qty_per_product)
print(f"\nEarliest Order Date: {earliest_date.strftime('%Y-%m-%d')}")
print(f"Latest Order Date:   {latest_date.strftime('%Y-%m-%d')}")
