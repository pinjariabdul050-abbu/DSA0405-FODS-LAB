import numpy as np
import pandas as pd
import scipy.stats as stats

# 1. Create dummy dataset if file does not exist
try:
    df = pd.read_csv('rare_elements.csv')
except FileNotFoundError:
    np.random.seed(42)
    sample_data = np.random.normal(loc=25.5, scale=4.2, size=100)
    df = pd.DataFrame({'concentration': sample_data})
    df.to_csv('rare_elements.csv', index=False)

# Load data
data = pd.read_csv('rare_elements.csv')['concentration'].values

# User inputs
sample_size = int(input("Enter sample size: "))
confidence_level = float(input("Enter confidence level (e.g., 0.95 for 95%): "))
precision = float(input("Enter desired level of precision (margin of error threshold): "))

# Take sample
sample = np.random.choice(data, size=sample_size, replace=False)

# Point Estimate (Sample Mean)
sample_mean = np.mean(sample)
sample_std = np.std(sample, ddof=1)
standard_error = sample_std / np.sqrt(sample_size)

# Confidence Interval
z_or_t = stats.t.ppf((1 + confidence_level) / 2, df=sample_size - 1)
margin_of_error = z_or_t * standard_error
ci_lower = sample_mean - margin_of_error
ci_upper = sample_mean + margin_of_error

print("\n--- RESULTS ---")
print(f"Point Estimate (Sample Mean): {sample_mean:.4f}")
print(f"Margin of Error: {margin_of_error:.4f}")
print(f"{confidence_level*100}% Confidence Interval: ({ci_lower:.4f}, {ci_upper:.4f})")

if margin_of_error <= precision:
    print(f"Achieved desired precision! (Margin of Error <= {precision})")
else:
    print(f"Precision target NOT met. (Margin of Error > {precision})")
