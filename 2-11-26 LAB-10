import matplotlib.pyplot as plt

months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun']
sales = [12000, 15000, 13500, 18000, 21000, 19500]

# 1. Line Plot
plt.figure(figsize=(8, 4))
plt.plot(months, sales, marker='o', color='b', linestyle='-')
plt.title('Monthly Sales Data (Line Plot)')
plt.xlabel('Month')
plt.ylabel('Sales ($)')
plt.grid(True)
plt.show()

# 2. Bar Plot
plt.figure(figsize=(8, 4))
plt.bar(months, sales, color='skyblue', edgecolor='black')
plt.title('Monthly Sales Data (Bar Plot)')
plt.xlabel('Month')
plt.ylabel('Sales ($)')
plt.show()
