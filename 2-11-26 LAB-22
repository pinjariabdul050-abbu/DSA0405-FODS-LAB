import numpy as np
import pandas as pd
import scipy.stats as stats

# Create sample dataset if missing
try:
    df = pd.read_csv('customer_reviews.csv')
except FileNotFoundError:
    df = pd.DataFrame({'rating': [4.5, 3.8, 5.0, 4.2, 4.0, 3.5, 4.8, 4.1, 2.9, 4.7, 5.0, 3.9, 4.3, 4.6]})
    df.to_csv('customer_reviews.csv', index=False)

df = pd.read_csv('customer_reviews.csv')
ratings = df['rating']

# Statistics calculation
mean_rating = ratings.mean()
std_rating = ratings.std(ddof=1)
n = len(ratings)
confidence_level = 0.95

# Calculate Confidence Interval using Student's t-distribution
degrees_of_freedom = n - 1
t_critical = stats.t.ppf((1 + confidence_level) / 2, df=degrees_of_freedom)
margin_of_error = t_critical * (std_rating / np.sqrt(n))

ci_lower = mean_rating - margin_of_error
ci_upper = mean_rating + margin_of_error

print("--- CUSTOMER SATISFACTION ANALYSIS ---")
print(f"Total Reviews Analyzed: {n}")
print(f"Sample Mean Rating: {mean_rating:.2f} / 5.0")
print(f"95% Confidence Interval for True Population Mean: ({ci_lower:.2f}, {ci_upper:.2f})")
