import pandas as pd
import matplotlib.pyplot as plt

data = {
    'Study_Hours': [1.5, 2.0, 3.0, 4.5, 5.0, 6.0, 7.5, 8.0, 9.0, 10.0],
    'Exam_Score': [48, 52, 60, 68, 72, 78, 85, 89, 93, 97]
}
df = pd.DataFrame(data)

corr = df['Study_Hours'].corr(df['Exam_Score'])
print(f"Pearson Correlation Coefficient: {corr:.4f}")

fig, axes = plt.subplots(1, 2, figsize=(10, 4))

# Scatter Plot
axes[0].scatter(df['Study_Hours'], df['Exam_Score'], color='teal')
axes[0].set_title('Scatter Plot: Study Hours vs Score')
axes[0].set_xlabel('Study Time (Hours)')
axes[0].set_ylabel('Exam Score')

# Line Plot
axes[1].plot(df['Study_Hours'], df['Exam_Score'], marker='o', color='darkorange')
axes[1].set_title('Trend Line: Study Hours vs Score')
axes[1].set_xlabel('Study Time (Hours)')
axes[1].set_ylabel('Exam Score')

plt.tight_layout()
plt.show()
